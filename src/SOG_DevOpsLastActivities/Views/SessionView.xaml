<UserControl x:Class="SOG_DevOpsLastActivities.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border Padding="12,7"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top">
            <DockPanel>
                <TextBlock VerticalAlignment="Center" DockPanel.Dock="Right" Text="{Binding ConnectionText}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnectionError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Config.Description}" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The features this session offers. -->
            <ListView Grid.Column="0"
                      BorderThickness="0,0,1,0"
                      ItemsSource="{Binding Features}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedItem="{Binding SelectedFeature}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,5">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                            <TextBlock FontSize="11"
                                       Style="{StaticResource MutedText}"
                                       Text="{Binding Description}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ContentControl Grid.Column="1" Margin="12,10" Content="{Binding SelectedFeature}" />
        </Grid>
    </DockPanel>
</UserControl>
