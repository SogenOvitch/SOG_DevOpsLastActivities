<Window x:Class="SOG_DevOpsLastActivities.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SOG DevOps Last Activities"
        Width="1400"
        Height="860"
        MinWidth="900"
        MinHeight="500"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource FgBrush}"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================ configurations -->
            <GroupBox Grid.Column="0" Header="Configurations">
                <DockPanel>
                    <StackPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
                        <Button Command="{Binding OpenSessionCommand}"
                                Content="Open session"
                                Style="{StaticResource AccentButton}"
                                ToolTip="Opens a tab on the selected configuration (or double-click it)" />
                        <UniformGrid Margin="0,6,0,0" Columns="3">
                            <Button Margin="0,0,3,0" Command="{Binding NewConfigCommand}" Content="New" />
                            <Button Margin="3,0" Command="{Binding EditConfigCommand}" Content="Edit" />
                            <Button Margin="3,0,0,0" Command="{Binding DeleteConfigCommand}" Content="Delete" />
                        </UniformGrid>
                        <UniformGrid Margin="0,6,0,0" Columns="2">
                            <Button Margin="0,0,3,0"
                                    Command="{Binding OpenFolderCommand}"
                                    Content="Open folder"
                                    ToolTip="{Binding ConfigFolder}" />
                            <Button Margin="3,0,0,0"
                                    Command="{Binding RefreshCommand}"
                                    Content="Refresh"
                                    ToolTip="Reads the folder again, for files added or edited by hand" />
                        </UniformGrid>
                    </StackPanel>

                    <ListView ItemsSource="{Binding Configs}"
                              MouseDoubleClick="OnConfigDoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItem="{Binding SelectedConfig}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,3">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <TextBlock FontSize="11"
                                               Style="{StaticResource MutedText}"
                                               Text="{Binding Description}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <!-- ================================================================== sessions -->
            <Grid Grid.Column="2">
                <TabControl ItemsSource="{Binding Sessions}"
                            SelectedItem="{Binding SelectedSession}"
                            Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Background="Transparent" Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                <TextBlock VerticalAlignment="Center" Text="{Binding Header}" />
                                <Button Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource TabCloseButton}"
                                        ToolTip="Close this session" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource MutedText}"
                           Text="Double-click a configuration to open a session on it."
                           Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
